# Django
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DB_NAME=trackable
DB_USER=trackable
DB_PASSWORD=trackable
DB_HOST=localhost
DB_PORT=5432

# CORS (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Base URL encoded in package QR labels (<url>/scan/<token>)
FRONTEND_BASE_URL=http://localhost:3000

# Media files
MEDIA_ROOT=/tmp/trackable_media
MEDIA_URL=/media/

# Business timezone: defines "today" and display; timestamps are stored in UTC
BUSINESS_TIMEZONE=Asia/Kolkata

# Email (optional)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=trackable@example.com

# Production only (ignored when DEBUG=True)
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# Password given to users created by `manage.py seed_demo` (DEMO data only)
DEMO_USER_PASSWORD=demo-pass-123!

# Logging: 'verbose' (text) or 'json' (one JSON object per line, for log shippers)
LOG_FORMAT=verbose

# Shared cache for login throttling across workers (optional; e.g. redis://localhost:6379/0)
REDIS_URL=
LOGIN_THROTTLE_RATE=10/min
